# =====================================================================
#  UniFind DPU - ตัวอย่างตัวแปรระบบ
#  1) คัดลอกไฟล์นี้เป็น .env   (cp .env.example .env)
#  2) สร้าง Secret Keys ด้วยคำสั่ง  cd backend && npm run keys  แล้ววางทับค่าด้านล่าง
#  ห้าม commit ไฟล์ .env ขึ้น Git เด็ดขาด
# =====================================================================

# ---------- Server ----------
NODE_ENV=development
PORT=3000
# ต้องตรงกับ URL ที่เปิดในเบราว์เซอร์ (ใช้ตรวจ Origin ป้องกัน CSRF)
APP_ORIGIN=http://localhost:3000
# ตั้งเป็น 1 เมื่อรันหลัง Reverse Proxy (เช่น Nginx) เพื่อให้ rate limit อ่าน IP จริงได้
TRUST_PROXY=0

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=unifind_app
DB_PASSWORD=change_me_strong_db_password
DB_NAME=unifind_dpu
DB_POOL_SIZE=10

# ---------- Secret Keys (สร้างใหม่ด้วย npm run keys) ----------
# AES-256-GCM key: hex 64 ตัวอักษร (32 ไบต์)
ENCRYPTION_KEY=
# JWT secret: อย่างน้อย 32 ตัวอักษร
JWT_SECRET=
JWT_EXPIRES_IN=2h
JWT_COOKIE_MAX_AGE_MIN=120

# Cookie Secure: Chrome/Edge/Firefox ยอมรับ Secure cookie บน http://localhost
# ถ้าทดสอบด้วย Safari ผ่าน http ให้ตั้ง false ชั่วคราว (ห้ามใช้ false ใน production)
COOKIE_SECURE=true

# ---------- Security policy ----------
BCRYPT_ROUNDS=12
ALLOWED_EMAIL_DOMAINS=dpu.ac.th
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
CLAIM_MAX_ATTEMPTS=3
CLAIM_LOCK_HOURS=24

# ---------- Matching ----------
MATCH_THRESHOLD=50

# ---------- รหัสผ่านบัญชีทดสอบ (ใช้โดย npm run seed เท่านั้น) ----------
SEED_USER_PASSWORD=Dpu@2026!
SEED_ADMIN_PASSWORD=Admin@DPU2026!
